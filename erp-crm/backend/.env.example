# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/erp_crm
# Neon/Supabase/Render: copy the connection string they give you
DATABASE_URL="postgresql://postgres:root@localhost:5433/erp_crm?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
